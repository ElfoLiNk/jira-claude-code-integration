{
  "version": "1.1",
  "_comment": "Phase gate dependency graph. Customize: copy this file and edit `phases.<name>.requires`/`artifacts`/`enforced` for your team's workflow. {TASK_ID} in fileGlob is replaced at runtime. Note: L1 tasks (context level=L1) receive advisory warnings instead of hard-blocks regardless of `enforced` — so test-write's approach requirement only binds L2·L3.",
  "phases": {
    "discover": {
      "requires": [],
      "enforced": false
    },
    "create": {
      "requires": [],
      "enforced": false
    },
    "init": {
      "requires": [],
      "enforced": true
    },
    "start": {
      "requires": ["init"],
      "enforced": true
    },
    "approach": {
      "requires": ["start"],
      "enforced": true
    },
    "test-write": {
      "requires": ["approach"],
      "artifacts": [
        { "fileGlob": "work/{TASK_ID}/plan.md" }
      ],
      "enforced": true
    },
    "impl": {
      "requires": ["test-write"],
      "enforced": true
    },
    "verify": {
      "requires": ["impl"],
      "enforced": true
    },
    "pr": {
      "requires": ["verify"],
      "enforced": true
    },
    "done": {
      "requires": ["verify"],
      "enforced": true
    }
  }
}
